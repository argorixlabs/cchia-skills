{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchia.cl/schemas/system.schema.json",
  "title": "CCHIA Security Compiler system intake",
  "type": "object",
  "properties": {
    "name": {"type": "string"},
    "description": {"type": "string"},
