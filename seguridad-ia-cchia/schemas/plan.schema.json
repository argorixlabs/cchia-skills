{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchia.cl/schemas/plan.schema.json",
  "title": "CCHIA Security Compiler execution plan",
  "type": "object",
  "required": ["schema_version", "assessment_id", "generated_at", "scope", "engine", "catalog", "applicability", "selected_controls", "selected_control_versions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_id": {"type": "string", "pattern": "^CCHIA-[A-F0-9]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "required": [
        "target",
        "target_fingerprint",
        "file_count",
        "signals",
        "signal_evidence",
        "signal_details",
        "collection",
        "collectors",
        "execution_mode"
      ],
      "properties": {
        "target": {"type": "string"},
        "system_description": {"type": ["string", "null"]},
        "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "file_count": {"type": "integer", "minimum": 0},
        "signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "signal_evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "signal_details": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["active", "confidence", "confidence_label", "evidence"],
            "properties": {
              "active": {"type": "boolean"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "confidence_label": {"enum": ["HIGH", "MEDIUM", "LOW"]},
              "evidence": {"type": "array", "items": {"type": "object"}}
            }
          }
        },
        "collection": {
          "type": "object",
          "required": [
            "mode", "file_count", "candidate_files", "complete", "truncated",
            "pass_eligible", "incomplete_reasons", "limits"
          ],
          "properties": {
            "mode": {"const": "read_only"},
            "file_count": {"type": "integer", "minimum": 0},
            "candidate_files": {"type": "integer", "minimum": 0},
            "complete": {"type": "boolean"},
            "truncated": {"type": "boolean"},
            "pass_eligible": {"type": "boolean"},
            "incomplete_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "limits": {"type": "object"}
          }
        },
        "collectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["collector_id", "collector_version", "status", "collected_at", "mode", "evidence_sha256"],
            "properties": {
              "collector_id": {"type": "string"},
              "collector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "status": {"enum": ["AVAILABLE", "UNAVAILABLE", "ERROR"]},
              "collected_at": {"type": "string", "format": "date-time"},
              "mode": {"const": "read_only"},
              "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "execution_mode": {"const": "read_only"}
      }
    },
    "engine": {
      "type": "object",
      "required": ["version", "sha256"],
      "properties": {"version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "catalog": {
      "type": "object",
      "required": ["root", "control_count", "fixture_count", "sha256"],
      "properties": {
        "root": {"type": "string"},
        "control_count": {"type": "integer", "minimum": 1},
        "fixture_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "control_version", "decision", "reasons"],
        "properties": {
          "control_id": {"type": "string"},
          "control_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "decision": {"enum": ["SELECTED", "NOT_APPLICABLE"]},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "selected_controls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "selected_control_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
    }
  }
}
