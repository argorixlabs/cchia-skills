{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchia.cl/schemas/collector-request.schema.json",
  "title": "CCHIA opt-in collector request",
  "type": "object",
  "additionalProperties": false,
  "required": ["collectors"],
  "properties": {
    "collectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["aws-iam", "az-role-assignments", "gcloud-iam", "gh-repo-security", "kubectl-cluster", "kubectl-rbac", "kubectl-workloads"]
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp_project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "aws_profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"
        },
        "azure_subscription": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._() -]{0,127}$"
        },
        "github_repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}$"
        },
        "kube_context": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,252}$"
        },
        "kube_namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,252}$"
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}
